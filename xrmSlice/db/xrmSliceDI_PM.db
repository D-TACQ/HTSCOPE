# xrmSliceDI_PM.db # call for every PORT, every ADDR (max 2)

record(waveform, "${HOST}:${UUT}:PM:${CYCLE}:DI32:${di32}")
{
    field(DTYP, "asynInt32ArrayIn")
    field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))XS_DI32_CH_RAW")
    field(FTVL, "ULONG")
    field(NELM, "${NSAM}")
    field(SCAN, "I/O Intr")
    field(HOPR, "2147483648")
    field(LOPR, "0")
    field(EGU,  "bits")
}
