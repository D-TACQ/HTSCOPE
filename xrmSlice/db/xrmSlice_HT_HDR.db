# xrmSlice_HT.db : PV's for each field in SOE_HOLD_HEADER

record(longin, "${HOST}:${UUT}:SOE:${ROW}:HDR:PV_ID")
{
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0,$(TIMEOUT))SOE_HLD_ENT_PV_ID")
    field(SCAN, "I/O Intr")
    field(EGU,  "u32")
}

record(longin, "${HOST}:${UUT}:SOE:${ROW}:HDR:EVENT")
{
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0,$(TIMEOUT))SOE_HLD_ENT_EVENT")
    field(SCAN, "I/O Intr")
    field(EGU,  "")
}


record(longin, "${HOST}:${UUT}:SOE:${ROW}:HDR:OFFSET_US")
{
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0,$(TIMEOUT))SOE_HLD_ENT_OFFSET_US")
    field(SCAN, "I/O Intr")
    field(EGU,  "μs")
}


record(longin, "${HOST}:${UUT}:SOE:${ROW}:HDR:CLIDAT")
{
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0,$(TIMEOUT))SOE_HLD_ENT_CLIDAT")
    field(SCAN, "I/O Intr")
    field(EGU,  "u32")
}


record(longin, "${HOST}:${UUT}:SOE:${ROW}:HDR:TS")
{
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0,$(TIMEOUT))SOE_HLD_ENT_TS")
    field(SCAN, "I/O Intr")
    field(EGU,  "u32")
}

record(longin, "${HOST}:${UUT}:SOE:${ROW}:HDR:DATA_OFFSET")
{
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0,$(TIMEOUT))SOE_HLD_ENT_DATA_OFFSET")
    field(SCAN, "I/O Intr")
    field(EGU,  "u32")
}



record(longin, "${HOST}:${UUT}:SOE:${ROW}:HDR:VER:REQ")
{
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0,$(TIMEOUT))SOE_HLD_VERSION_REQUIRED")
    field(SCAN, "I/O Intr")
    field(EGU,  "u32")
    field(DESC, "HT version of this exe")
}

record(longin, "${HOST}:${UUT}:SOE:${ROW}:HDR:VER:RX")
{
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0,$(TIMEOUT))SOE_HLD_VERSION_RECEIVED")
    field(SCAN, "I/O Intr")
    field(EGU,  "u32")
    field(DESC, "HT version received")
}

record(bo, "${HOST}:${UUT}:SOE:${ROW}:HDR:VER:CHECK")
{
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0,$(TIMEOUT))SOE_HLD_VERSION_CHECK")
    field(ZNAM, "NOCHECK")
    field(ONAM, "CHECK")
    field(DESC, "Enable checking")
}

