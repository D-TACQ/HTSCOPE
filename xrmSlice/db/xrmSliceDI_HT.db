record(longin, "${HOST}:${UUT}:SOE:${ROW}:DI32:${DI}")
{
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))XS_DI32_CH_RAW")
    field(SCAN, "I/O Intr")
}
