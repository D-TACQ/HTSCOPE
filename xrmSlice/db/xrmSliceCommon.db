# instantiate fields for XrmSliceCommon
# EOFF, ESLO are dynamic (user can change gain on the fly), 
#   so a "closed_loop" monitor makes sense
# SMPL parameters: if it were easy to specify GROUP links, this would be a piece of cake.
# Since we have to break it into fields, and the db creation process already deconstructed
# SMPL, which is constant, the simplest route is to make a static PINI init..


record(aao, "${HOST}:${UUT}:0:AI:CAL:ESLO")
{
	field(DTYP, "asynFloat32ArrayOut")
	
	field(DOL, {pva:{pv:"${UUT}:0:AI:CAL:ESLO", "proc":"CPP"}})
	field(OMSL, "closed_loop")
	field(FTVL, "FLOAT")
	field(OUT,  "@asyn($(PORT),0,$(TIMEOUT))XS_ESLO")
  	field(NELM, "193")
}
	
record(aao, "${HOST}:${UUT}:0:AI:CAL:EOFF")
{
	field(DTYP, "asynFloat32ArrayOut")
	
	field(DOL, {pva:{pv:"${UUT}:0:AI:CAL:EOFF", "proc":"CPP"}})
	field(OMSL, "closed_loop")
	field(FTVL, "FLOAT")
	field(OUT,  "@asyn($(PORT),0,$(TIMEOUT))XS_EOFF")
	field(NELM, "193")
}

# @@todo: we should get the SMPL band back together again
# @@todo: use DOL=$SSB, closed_loop for true CONST on power up init!

record(longout, "${HOST}:${UUT}:SMPL:SSB")
{
	field(DTYP, "asynInt32")
	field(VAL,  "${SSB}")
	field(PINI, "YES")
	field(OUT, "@asyn($(PORT),0,$(TIMEOUT))XS_SMPL_SSB")
}

