# xrmSlice_HT.db : common init for HT


record(aao, "${HOST}:${UUT}:SOE_HLD")
{
	field(DTYP, "asynInt32ArrayOut")
	field(OUT,  "@asyn($(PORT),0,$(TIMEOUT))HT_RAW_INPUT")
	field(OMSL, "closed_loop")
	field(DOL,  {pva: {pv:"${UUT}:SOE_HLD", "proc":"CPP"}})
	field(FTVL, "LONG")
	field(NELM, "$(HT_BUF_NELM)")
}

record(bo, "${HOST}:${UUT}:SOE:00:HDR:VER:CHECK")
{
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0,$(TIMEOUT))SOE_HLD_VERSION_CHECK")
    field(ZNAM, "NOCHECK")
    field(ONAM, "CHECK")
    field(DESC, "Enable checking")
    field(PINI, "YES")
    field(VAL,  "0")
}


