# xrmSliceET_HT.db # call for every PORT
# special fields for one HT ENTRY, all ADDR=0


record(longin, "${HOST}:${UUT}:SOE:${ROW}:WRVS")
{
	field(DTYP, "asynInt32")
	field(INP,  "@asyn($(PORT),0,$(TIMEOUT))XS_SP32_WRVS")
	field(SCAN, "I/O Intr")
	field(EGU,  "s")
}

record(longin, "${HOST}:${UUT}:SOE:${ROW}:WRVT")
{
	field(DTYP, "asynInt32")
	field(INP,  "@asyn($(PORT),0,$(TIMEOUT))XS_SP32_WRVT")
	field(SCAN, "I/O Intr")
	field(EGU,  "ticks")
}

record(longin, "${HOST}:${UUT}:SOE:${ROW}:WRUS")
{
	field(DTYP, "asynInt64")
	field(INP,  "@asyn($(PORT),0,$(TIMEOUT))XS_SP32_WRUS")
	field(SCAN, "I/O Intr")
	field(EGU,  "us")
}
