# xrmSlice_PM.db # PM:BUF blob: call for every PORT


record(aao, "${HOST}:${UUT}:PM:BUF:${CYCLE}")
{
	field(DTYP, "asynInt32ArrayOut")
	field(OUT,  "@asyn($(PORT),0,$(TIMEOUT))PM_RAW_INPUT")
	field(OMSL, "closed_loop")
	field(DOL,  {pva: {pv:"${UUT}:PM:BUF:${CYCLE}", "proc":"CPP"}})
	field(FTVL, "LONG")
	field(NELM, "$(PM_BUF_NELM)")
}

record(aai, "${HOST}:${UUT}:PM:${CYCLE}:WRVS")
{
	field(DTYP, "asynInt32ArrayIn")
	field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))XS_SP32_WRVS")
	field(FTVL, "ULONG")
	field(NELM, "$(NSAM)")
	field(SCAN, "I/O Intr")
}

record(aai, "${HOST}:${UUT}:PM:${CYCLE}:WRVT")
{
	field(DTYP, "asynInt32ArrayIn")
	field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))XS_SP32_WRVT")
	field(FTVL, "ULONG")
	field(NELM, "$(NSAM)")
	field(SCAN, "I/O Intr")
}

record(aai, "${HOST}:${UUT}:PM:${CYCLE}:WRUS")
{
	field(DTYP, "asynInt64ArrayIn")
	field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))XS_SP32_WRUS")
	field(FTVL, "UINT64")
	field(NELM, "$(NSAM)")
	field(SCAN, "I/O Intr")
}
